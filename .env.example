# ──────────────────────────────────────────────────────────────────────────
# RatioVault backend (FastAPI) — example env file
# Copy to `api/.env` and fill in real values for local development.
# All subscription-related vars default to empty string in code so endpoints
# fail closed when a secret is missing.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ── CORS (comma-separated list of allowed origins) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── SEC EDGAR (yfinance/SEC require a real UA — app crashes on default) ──
SEC_USER_AGENT=RatioVault contact@yourdomain.com

# ── Chart cache ───────────────────────────────────────────────────────────
CHART_CACHE_TTL=300
CHART_CACHE_MAX_SIZE=100

# ── Supabase (service-role + JWT verification) ────────────────────────────
# SUPABASE_URL: https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY: service_role key from Supabase dashboard (KEEP SECRET)
# SUPABASE_JWT_SECRET: JWT secret used to verify user access tokens
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Internal cron auth (retention endpoint fails closed if empty) ─────────
# Shared secret sent as `X-Internal-Token` by the cron scheduler.
INTERNAL_CRON_TOKEN=

# ── Paddle Billing (MoR — supersedes LemonSqueezy 2026-04-30) ─────────────
# PADDLE_ENVIRONMENT: sandbox | production. PADDLE_API_BASE auto-derived if empty.
# PADDLE_API_KEY: server-side API key (Bearer auth)
# PADDLE_NOTIFICATION_SECRET: signing secret for webhook HMAC-SHA256 (Paddle-Signature header)
# PADDLE_PRICE_ID_*: Paddle price IDs (pri_xxx) per billing interval
PADDLE_ENVIRONMENT=production
PADDLE_API_BASE=
PADDLE_API_KEY=
PADDLE_NOTIFICATION_SECRET=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_QUARTERLY=
PADDLE_PRICE_ID_SEMIANNUAL=
PADDLE_PRICE_ID_YEARLY=
PADDLE_PRICE_ID_FOUNDER=
